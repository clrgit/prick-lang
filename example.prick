
#if ( $env = prod && ( $env = prod ) )
# true.sql
#else
# false.sql
#end

include.prick # Effectively include the file
#example.d/

# IN expressions
if $env ^ (prod, test)
  true.sql
else
  false.sql
end

# Global phase
init {
  init1.sql
  provide part
  init2.sql
}

# Main Schema
schema my_schema {
  my_schema.sql
  # Function
  function my_function {
    my_function.sql
  }
  init {
  }

  # If statement with constant expression
  if $env = prod
    env_eq_prod.sql
    snippet.prick
  else
    env_ne_prod.sql
  end
  if $env = test
    env_eq_test.sql
  else
    env_ne_test.sql
  end

  # If statement with version expression
  if $ver ~> 1.2
    has_ver.sql
  else
    not_ver.sql
  end

  # If statement with unresolved expression
  if r?
    has_r.sql
  else
    not_r.sql
  end

  provide r

# case version
#   when ~> 1.2.3
#     a.sql
#   when < 4.5.6
#     b.sql
# else
#   c.sql
# end

  # Provide
  a.sql
  provide has_a
  b.sql
  provide has_b

  # Require
  require another_schema
  require another_schema.has_another_schema

  # Files
  s.sql
  r.rb
  p.psql
  f.fox

  # Multiple files
  t1.sql t2.sql t3.sql

  # Commands
  exec ls -l
  eval ls -l
  # ruby r.rb # Not implemented
  sql |
    select 1
    from table
    where column = 42

  # Function call
  # call my_function
}

# Another schema
schema another_schema {
  another_schema.sql
  require my_schema.r
  after_require.sql
  provide has_another_schema
}

