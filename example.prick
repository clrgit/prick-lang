
# Schema
schema my_schema {

  # Function
  function my_function {
    # Case statment
    case version
      when ~> 1.2.3
        a.sql
      when < 4.5.6
        b.sql
    else
      c.sql
    end
  }

  # Phase
  init {
    # If statement with constant expression
    if ( env text || cmd build )
      ia.sql
    elsif ! env prod
      ib.sql
    else
      ic.sql
    end
  }

  # Provide
  a.sql
  provide has_a
  b.sql
  provide has_b # has_b depends on has_a that depends on the schema

  # If statement
  if env prod
    c.sql
    provide has_c
  else
    provide has_not_c
  end

  if ! env prod
    d.sql e.sql
    provide has_d
  end

  if resource has_c
    res.sql
  end

# if var env prod
#   var_env_prod.sql
# else
#   not_var_env_prod.sql
# end

# case var prod
#   when prod
#     case_var_prod.sql
#   else
#     oops.sql
# end

  # Unresolved if-statement
  before_unresolved.sql
  if resource has_d
    has_res_d.sql
    if resource has_e
      has_res_e.sql
    else
      not_res_e.sql
    end
  else
    not_res_d.sql
    if resource has_f
      has_res_f.sql
    else
      not_res_f.sql
    end
  end
  after_unresolved.sql

  before_parallel.sql
  if ! resource has_d
    not_res_d_2.sql
    provide has_f
  end
  after_parallel.sql


  # Make
  exec |
    if [ file1.sql -nt file.rb -o file2.sql -nt data.txt ]; then
      something.rb
    fi

  file1.sql
  file2.sql

  # Require
  require another_schema
  require my_schema.resource
  require a.b c.d

  # Files
  r.rb
  p.psql

  t1.sql t2.sql t3.sql

  # Commands
  exec ls -l
  eval ls -l
  # ruby r.rb # Not implemented
  sql |
    select 1
    from table
    where column = 42

  # Function call
  #call my_function
}

__END__

}

