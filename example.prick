
# Schema
schema my_schema {

  # Function
  function my_function {
    # Case statment
    case version
      when ~> 1.2.3
        a.sql
      when < 4.5.6
        b.sql
    else
      c.sql
    end
  }

  # Phase
  init {
    # If statement
#   if version ~> 1.2 && ( env prod || cmd build )
    if ( env text || cmd build )
      ia.sql
    elsif ! env prod
      ib.sql
    else
      ic.sql
    end
  }

  # Provide
  a.sql
  provide has_a
  b.sql
  provide has_b # has_b depends on has_a that depends on the schema

  # If statement
  if env prod
    c.sql
    provide has_c
  else
    provide has_not_c
  end

  if ! env prod
    d.sql e.sql
    provide has_d
  end

  if resource has_c
    res.sql
  end


  # Make
  exec |
    if [ file1.sql -nt file.rb -o file2.sql -nt data.txt ]; then
      something.rb
    fi

  file1.sql
  file2.sql

  # Require
  require another_schema
  require my_schema.resource
  require a.b c.d

  # Files
  r.rb
  p.psql

  t1.sql t2.sql t3.sql

  # Commands
  exec ls -l
  eval ls -l
  # ruby r.rb # Not implemented
  sql |
    select 1
    from table
    where column = 42

  # Function call
  #call my_function
}

__END__

}

