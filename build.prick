# EXEC TEXT
exec ls -l

# EXEC MULTILINE
exec |
  # This comment should survive
  ls -l
  sed 's/#/SURVIVOR/' gryf.txt # this too




# Meta
meta.fox
if env == :meta
  exec make-defs >defs.sql
  defs.sql
  sql "select do_some_function()"
  break
else
  defs.sql
end

# Static check
if env = :seeds
  do_something.sql
end

# Dynamic check. The result of the block is the result of the last statement:
# If an eval then the result of running the query (a single-row, single-column
# containing true or false. If an exec, the exit status is used (note that the
# exec expression can be an arbitrary bash snippet that can interpret any
# result into a exit status
#
