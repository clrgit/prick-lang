#!/usr/bin/env ruby

require_relative '../lib/prick/lang.rb'

require 'shellopts'

SPEC = %(
  @ Prick compiler

  -- CMD [TARGET...] [VAR=VAL...]

  Compile a prick project

  -f,file=FILE|DIR
    Prick source file. The default is the '#{Prick::Lang::Compiler::DEFAULT_SOURCE_FILE}'
    file in the project main directory

  --state-file=FILE
    Prick compiler state file. Default is '#{Prick::Lang::Compiler::DEFAULT_STATE_FILE}'

  --timestamp=TIMESTAMP
    Override timestamp from the state file

  +x,exclude=SCHEMA,
    Comma-separated list of excluded schemas

  -D,dump=tokens|ast|idr|links|deps|marks|units|state,
    Dump debug. Default is 'ast'

  -X,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  -T,trace
    Enable tracer. Used for debugging


  Commands
    make
      * When a build file changes all schemas within the build file is marked
        dirty together with required resources

        P: This means that phases and hence schemas will need to be recreated
          S: It may be assumed that if there are no dependencies between schema
             phases, then they don't need to be recompiled
          S: Keep track of seed files and only wipe them when phase needs to be
             re-run

        P: How to re-run phases
          S: init phase - automatically rebuilds everything
             seed phase - clear seed tables
             term phase - should be re-entrant
             auth phase - should be re-entrant

    merge
      * It is assumed that a migration has updated the schema of the production
        database and that links that would be broken by changes in seed data have
        been fixed beforehand

      * Pseudo-code

          build new version
          dump meta and const table names
          backup seed
          move seed to temporary tables
          backup production excl. meta and const from table name dump
          load production backup
          merge seed tables

          P: How to handle new or deleted tables?
            S: The new database dumps a list of tables to exclude
            S: The production database knows its meta and const tables. It then
               exclude those tables unless they're included in the table name
               dump

      * New phase

          merge {
            meta table1 table2
            sync this_table key
            sync that_table key
            copy another_table # <- cause the table to be registered as a seed/copy table
            seed schema.table
            some_script.sql
          }

          N: Run completely without constraints/triggers/indexes etc. to be able to
             copy tables. No, not needed. Just use the usual restore backup mode

          N: The merge phase is all we need to identify seed tables. No,
             because we can execute any script or command in a merge section
             S: Introduce a seed keyword that marks the table as an unspecified
                seed table that should be moved to a temporary table before
                loading production and then merged using scripts/commands

          N: It is possible to do a sanity check of the merge phase by
             comparing non-empty tables with the set of referenced phases

      * Data types

        - meta    # Meta tables. Meta tables are used to create other schema objects
                  # and are read-only. They can't be referenced by id (except
                  # between meta tables). Defined by the 'meta' keyword
        - copy    # Read-only seed data
        - sync    # Writable seed data
        - seed    # Copy & sync data
        - app     # Application data
        - data    # All data


  Meta, sync, cop & seed tables
    * Meta tables may not be referred to by ID except by other meta tables
    * Seed tables can only refer to other seed tables in the same schema
    * Sync tables should have a unique kind. They can be linked to by id
    * Copy tables should have a unique kind. They can't be linked to by id


  Syntax

    PROGRAM ::= BLOCK

    BLOCK ::= STMT+

    STMT ::=
        DECL_STMT
      | PHASE-STMT
      | OPTION_STMT
      | PROVIDE-STAT
      | REQUIRE_STMT
      | MAKE-STMT
      | IF-STMT
      | CASE-STMT
      | COMMAND-STMT
      | FILE-STMT
      | DUMP-STMT
      | LOAD-STMT
      | SNAPSHOT-STMT
      | RESTORE-STMT
      | RETURN-STMT
      | ECHO-STMT

    DECL-STMT ::=
        schema IDENT BLOCK-ARGS
      | function IDENT BLOCK-ARGS

    PHASE-STMT ::=
        [init | term | meta | seeds | auth] BLOCK-ARGS

    OPTION_STMT ::=
      # TODO

    PROVIDE-STMT ::=
      provide IDENT

    REQUIRE-STMT ::=
      require REF+

    ECHO-STMT ::=
      echo .*

    MAKE-STMT ::=
      make PATH+
        BLOCK

    IF-STMT ::=
        if EXPR BLOCK end
      | if EXPR BLOCK else BLOCK end
      | if EXPR BLOCK ( elsif EXPR <NL> BLOCK )+ ( else BLOCK )? end

    CASE-STMT ::=
        case VAR-EXPR WHEN-STMT... [ else COMMAND... ] end

    WHEN-STMT ::=
        when ( EXPR | OPER EXPR )+ COMMAND...

    COMMAND-STMT ::=
        exec SOURCE
      | eval SOURCE
      | ruby RUBY_SCRIPT ARGUMENTS...
      | sql SOURCE
      | call REF+

    DUMP-STMT ::=
      dump BACKUP BACKUP_KINDS OBJECT_BLOCK
      load BACKUP ( schema | data )? OBJECT_BLOCK
      snapshot BACKUP OBJECT_BLOCK
      restore BACKUP OBJECT_BLOCK

    FILE-STMT ::= FILE+

    EXIT-STMT ::= return INTEGER

    BLOCK-ARGS ::=
        COMMAND-STMT
      | FILE-STMT...
      | BLOCK

    EXPR ::=
        PREFIX_OP EXPR
      | EXPR BINARY_OP EXPR
      | EXPR SUFFIX_OP
      | VARIABLE
      | LITERAL

    VARIABLE ::=
        BUILTIN_VARIABLES
      | COMMAND_VARIABLES
      | ENVIRONMENT_VARIABLES

    BUILTIN_VARIABLES ::=
        '$prj'
      | '$env'
      | '$ver'
      | '$cmd'
      | '$user'

    COMMAND_VARIABLES ::=
        '$' DOWNCASED_IDENTIFIER

    ENVIRONMENT_VARIABLES ::=
        '$' UPCASED_IDENTIFIER

    PREFIX_OP ::=
        '!'

    INFIX_OP ::=
        '&&'
      | '||'
      | '<='
      | '<'
      | '=='
      | '='
      | '!='
      | '>='
      | '>'
      | '~>'

    SUFFIX_OP ::=
        '?'

    # Files
    PATH ::= <path> '/' <*>
    FILE ::= <path> '/' <*.sql> | <*.psql> | <*.fox> | <*.prick> | <*.rb>

    # Reference & identifier
    REF ::= .? IDENT ( . IDENT )*
    IDENT ::= /[\w.]+/

    # Inline source
    SOURCE ::=
        <line>
      | '|' <indented lines>

)

opts, args = ShellOpts.process(SPEC, ARGV)

file = opts.file || Prick::Lang::Compiler::DEFAULT_SOURCE_FILE
USE_EXCEPTION = opts.exception?
Trace.enable if opts.trace?
ShellOpts.exception = USE_EXCEPTION
state_file = opts.state_file || Prick::Lang::Compiler::DEFAULT_STATE_FILE
timestamp = opts.timestamp && Time.parse(opts.timestamp)
exclude = opts.exclude

# Extract command
cmd = args.extract(1)
%w(build make run).include?(cmd) or ShellOpts::error "Illegal command: #{cmd}"

# Extract targets
targets = []
while arg = args.first
  break if arg !~ /^#{Prick::Lang::Token::TARGET_PATTERN}$/
  targets << args.shift
end
targets = [Prick::Lang::Compiler::DEFAULT_TARGET] if targets.empty?

# FIXME
#BUILTIN_VARIABLES = { cmd: "build", env: "prod", ver: Semver.new("1.2.3"), user: "me" }
BUILTIN_VARIABLES = { env: "prod", ver: Semver.new("1.2.3"), user: "me" }

# Extract variable assignments
variables = BUILTIN_VARIABLES.dup
if arg = args.shift
  case arg
    when /^(\w+)=(\S*)$/
      variables[$1.to_sym] = $2
    else
      ShellOpts::error "Illegal argument '#{arg}'"
  end
end

# Create compiler object
compiler = Prick::Lang::Compiler.new(
    file, targets,
    mode: cmd.to_sym,
    state_file: state_file,
    timestamp: timestamp,
    exclude: exclude,
    variables: variables)

# Handle dump option. 'units' is the default
if opts.dump?
  kinds = opts.dump || "units"
  (unknowns = kinds - Prick::Lang::DUMP_KINDS) or ShellOpts::error "Illegal value for --dump '#{unknowns.first}'"
  Prick::Lang.dump(compiler, kinds)
  exit
end

# Compile
begin
  compiler.compile
rescue => ex
  raise Prick::Lang::ErrorFunctions.pretty_backtrace!(ex)
end

