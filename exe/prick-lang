#!/usr/bin/env ruby

require_relative '../lib/prick/lang.rb'

require 'shellopts'

SPEC = %(
  @ Compile a prick file

  -- FILE

  -x,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  Syntax

    SOURCE-FILE ::= STMT...

    STMT ::=
        DECL_STMT
      | GROUP-STMT
      | PHASE-STMT
      | OPTION_STMT
      | REQUIRE_STMT
      | IF-STMT
      | CASE-STMT
      | MAKE-STMT
      | COMMAND-STMT
      | FILE-STMT
      | EXIT-STMT

    DECL-STMT ::=
        schema SCHEMA_NAME BLOCK-ARGS
      | gruop SCHEMA_NAME BLOCK-ARGS

    OPTION_STMT ::=
      # TODO

    REQUIRE_STMT ::=
      require SCHEMANAME|GROUPREF

    IF-STMT ::=
        if EXPR then COMMAND... end
      | if EXPR then COMMAND... else COMMAND... end
      | if EXPR then COMMAND... elsif EXPR... end

    EXPR ::=
        SIMPLE-EXPR
      | ! EXPR
      | EXPR && EXPR
      | EXPR || EXPR
      | '(' EXPR ')'

    CASE-STMT ::=
        case VAR-EXPR WHEN-STMT... [ else COMMAND... ] end

    WHEN-STMT ::=
        when VAL-EXPR COMMAND...





    PHASE-STMT ::=
        [init | term | meta | seeds | auth] BLOCK-ARGS

    COMMAND-STMT ::=
        exec BASH-EXPR
      | eval BASH-EXPR
      | ruby RUBY_SCRIPT ARGUMENTS...
      | sql SQL-EXPR

    FILE-STMT ::= PATH...

    EXIT-STMT ::= exit INTEGER

    SIMPLE-EXPR ::=
        env ENVIRONMENT+
      | cmd COMMAND+
      | user USER+
      | version VER_EXPR+
      | schema SCHEMANAME
      | object OBJECTREF
      | group GROUPREF


    VAR-EXPR ::= env | cmd | user | version | schema | object | group

    VER-EXPR ::= VER-OP VER

    VAL-EXPR ::=
        IDENT
      | OBJREF
      | GRPREF
      | VER
      | VER-EXPR

    BLOCK-ARGS ::=
        COMMAND-STMT
      | FILE-STMT...
      |  BLOCK

    BASH-EXPR ::= '|' <indented lines>

    PATH ::= <path>/FILE
    FILE ::= <*.sql> | <*.psql> | <*.fox> | <*.prick> | <*.rb>


    SCHEMA_NAME ::= IDENT
    OBJECT_NAME ::= IDENT
    GROUP_NAME ::= IDENT
    OBJREF ::= .? OBJECT_NAME ( . OBJECT_NAME )*
    GRPREF ::= ::? GROUP_NAME ( :: GROUP_NAME )*

    IDENT ::= /[\w.]+/
    REF ::=
)

opts, args = ShellOpts.process(SPEC, ARGV)

USE_EXCEPTION = opts.exception?

file = args.expect(1)

compiler = Prick::Lang::Compiler.new(file)

begin
  compiler.compile
rescue => ex
  raise Prick::Lang::ErrorFunctions.pretty_backtrace!(ex)
end

