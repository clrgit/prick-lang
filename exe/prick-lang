#!/usr/bin/env ruby

require_relative '../lib/prick/lang.rb'

require 'shellopts'

SPEC = %(
  @ Compile a prick file

  -- FILE

  -x,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  -d,dump=tokens|ast|idr?
    Dump debug. Default is 'ast'


  Syntax

    PROGRAM ::= BLOCK

    BLOCK ::= STMT+

    STMT ::=
        DECL_STMT
      | PHASE-STMT
      | OPTION_STMT
      | PROVIDE-STAT
      | REQUIRE_STMT
      | MAKE-STMT
      | IF-STMT
      | CASE-STMT
      | COMMAND-STMT
      | FILE-STMT
      | RETURN-STMT

    DECL-STMT ::=
        schema IDENT BLOCK-ARGS
      | function IDENT BLOCK-ARGS

    PHASE-STMT ::=
        [init | term | meta | seeds | auth] BLOCK-ARGS

    OPTION_STMT ::=
      # TODO

    PROVIDE-STMT ::=
      provide IDENT

    REQUIRE-STMT ::=
      require REF+

    MAKE-STMT ::=
      make FILE+ from PATH+
        BLOCK
      end

    IF-STMT ::=
        if EXPR BLOCK end
      | if EXPR BLOCK else BLOCK end
      | if EXPR BLOCK ( elsif EXPR <NL> BLOCK )+ ( else BLOCK )? end

    CASE-STMT ::=
        case VAR-EXPR WHEN-STMT... [ else COMMAND... ] end

    WHEN-STMT ::=
        when VAL-EXPR COMMAND...

    COMMAND-STMT ::=
        exec SOURCE
      | eval SOURCE
      | ruby RUBY_SCRIPT ARGUMENTS...
      | sql SOURCE
      | call REF+

    FILE-STMT ::= FILE+

    EXIT-STMT ::= return INTEGER

    BLOCK-ARGS ::=
        COMMAND-STMT
      | FILE-STMT...
      | BLOCK

    EXPR ::=
        SIMPLE-EXPR
      | ! EXPR
      | EXPR && EXPR
      | EXPR || EXPR
      | '(' EXPR ')'

    # 'env', 'cmd', and 'user' or's their arguments together, 'version' and's
    # them
    SIMPLE-EXPR ::=
        env IDENT+
      | cmd IDENT+
      | user IDENT+
      | schema IDENT
      | object REF
      | resource REF
      | version VER_EXPR+

    VAR-EXPR ::= env | cmd | user | version | schema | object | resource

    VER-EXPR ::= VER-OP VER

    VAL-EXPR ::=
        IDENT
      | VER
      | VER-EXPR

    # Files
    PATH ::= <path>/<*>
    FILE ::= <path> / <*.sql> | <*.psql> | <*.fox> | <*.prick> | <*.rb>

    # Reference & identifier
    REF ::= .? IDENT ( . IDENT )*
    IDENT ::= /[\w.]+/

    # Inline source
    SOURCE ::=
        <line>
      | '|' <indented lines>

)

opts, args = ShellOpts.process(SPEC, ARGV)
USE_EXCEPTION = opts.exception?
ShellOpts.exception = USE_EXCEPTION
file = args.expect(1)

# Handle dump option
if opts.dump?
  kind = opts.dump || "ast"
  Prick::Lang::DUMP_KINDS.include?(kind) or
      ShellOpts::error "Illegal value for --dump '#{kind}'"
  Prick::Lang.dump(file, kind)
  exit
end

# Compile
compiler = Prick::Lang::Compiler.new(file)
begin
  compiler.compile
rescue => ex
  raise Prick::Lang::ErrorFunctions.pretty_backtrace!(ex)
end


