#!/usr/bin/env ruby

require_relative '../lib/prick/lang.rb'

require 'shellopts'

SPEC = %(
  @ Compile a prick file

  -- FILE

  -x,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  Syntax

    PROGRAM ::= BLOCK

    STMT ::=
        DECL_STMT
      | PHASE-STMT
      | OPTION_STMT
      | PROVIDE-STAT
      | REQUIRE_STMT
      | IF-STMT
      | CASE-STMT
      | MAKE-STMT
      | COMMAND-STMT
      | FILE-STMT
      | RETURN-STMT

    DECL-STMT ::=
        schema IDENT BLOCK-ARGS
      | function IDENT BLOCK-ARGS

    PHASE-STMT ::=
        [init | term | meta | seeds | auth] BLOCK-ARGS

    OPTION_STMT ::=
      # TODO

    PROVIDE-STMT ::=
      provide IDENT

    REQUIRE_STMT ::=
      require REF+

    IF-STMT ::=
        if EXPR BLOCK end
      | if EXPR BLOCK else BLOCK end
      | if EXPR BLOCK ( elsif EXPR <NL> BLOCK )+ ( else BLOCK )? end

    CASE-STMT ::=
        case VAR-EXPR WHEN-STMT... [ else COMMAND... ] end

    WHEN-STMT ::=
        when VAL-EXPR COMMAND...

    COMMAND-STMT ::=
        exec SOURCE
      | eval SOURCE
      | ruby RUBY_SCRIPT ARGUMENTS...
      | sql SOURCE
      | call REF+

    FILE-STMT ::= PATH...

    EXIT-STMT ::= return INTEGER

    BLOCK-ARGS ::=
        COMMAND-STMT
      | FILE-STMT...
      | BLOCK

    BLOCK ::= STMT+

    EXPR ::=
        SIMPLE-EXPR
      | ! EXPR
      | EXPR && EXPR
      | EXPR || EXPR
      | '(' EXPR ')'

    # 'env', 'cmd', and 'user' or's their arguments together, 'version' and's
    # them
    SIMPLE-EXPR ::=
        env IDENT+
      | cmd IDENT+
      | user IDENT+
      | schema IDENT
      | object REF
      | resource REF
      | version VER_EXPR+

    VAR-EXPR ::= env | cmd | user | version | schema | object | resource

    VER-EXPR ::= VER-OP VER

    VAL-EXPR ::=
        IDENT
      | VER
      | VER-EXPR

    PATH ::= <path>/FILE
    FILE ::= <*.sql> | <*.psql> | <*.fox> | <*.prick> | <*.rb>
    REF ::= .? IDENT ( . IDENT )*

    SOURCE ::=
        <line>
      | '|' <indented lines>

    IDENT ::= /[\w.]+/
)

opts, args = ShellOpts.process(SPEC, ARGV)

USE_EXCEPTION = opts.exception?

file = args.expect(1)

compiler = Prick::Lang::Compiler.new(file)

begin
  compiler.compile
rescue => ex
  raise Prick::Lang::ErrorFunctions.pretty_backtrace!(ex)
end


