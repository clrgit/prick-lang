#!/usr/bin/env ruby

require_relative '../lib/prick/lang.rb'

require 'shellopts'

SPEC = %(
  @ Prick compiler

  -- CMD [TARGET...] [VAR=VAL...]

  Compile a prick project

  -f,file=FILE|DIR
    Prick source file. The default is the '#{Prick::Lang::Compiler::DEFAULT_SOURCE_FILE}'
    file in the project main directory

  +x,exclude=SCHEMA,
    Comma-separated list of excluded schemas

  --resource-file=FILE
    Mark state file. The mark file contains a list of completed targets and is
    used by 'prick make'. Default is '#{Prick::Lang::Compiler::COMPLETED_RESOURCES_FILE}'

  -D,dump=tokens|ast|idr|links|deps|units|state,
    Dump debug. Default is 'ast'

  -X,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  -T,trace
    Enable tracer. Used for debugging

  Syntax

    PROGRAM ::= BLOCK

    BLOCK ::= STMT+

    STMT ::=
        DECL_STMT
      | PHASE-STMT
      | OPTION_STMT
      | PROVIDE-STAT
      | REQUIRE_STMT
      | MAKE-STMT
      | IF-STMT
      | CASE-STMT
      | COMMAND-STMT
      | FILE-STMT
      | DUMP-STMT
      | LOAD-STMT
      | SNAPSHOT-STMT
      | RESTORE-STMT
      | RETURN-STMT

    DECL-STMT ::=
        schema IDENT BLOCK-ARGS
      | function IDENT BLOCK-ARGS

    PHASE-STMT ::=
        [init | term | meta | seeds | auth] BLOCK-ARGS

    OPTION_STMT ::=
      # TODO

    PROVIDE-STMT ::=
      provide IDENT

    REQUIRE-STMT ::=
      require REF+

    MAKE-STMT ::=
      make PATH+
        BLOCK

    IF-STMT ::=
        if EXPR BLOCK end
      | if EXPR BLOCK else BLOCK end
      | if EXPR BLOCK ( elsif EXPR <NL> BLOCK )+ ( else BLOCK )? end

    CASE-STMT ::=
        case VAR-EXPR WHEN-STMT... [ else COMMAND... ] end

    WHEN-STMT ::=
        when ( EXPR | OPER EXPR )+ COMMAND...

    COMMAND-STMT ::=
        exec SOURCE
      | eval SOURCE
      | ruby RUBY_SCRIPT ARGUMENTS...
      | sql SOURCE
      | call REF+

    DUMP-STMT ::=
      dump BACKUP BACKUP_KINDS OBJECT_BLOCK
      load BACKUP ( schema | data )? OBJECT_BLOCK
      snapshot BACKUP OBJECT_BLOCK
      restore BACKUP OBJECT_BLOCK

    FILE-STMT ::= FILE+

    EXIT-STMT ::= return INTEGER

    BLOCK-ARGS ::=
        COMMAND-STMT
      | FILE-STMT...
      | BLOCK

    EXPR ::=
        PREFIX_OP EXPR
      | EXPR BINARY_OP EXPR
      | EXPR SUFFIX_OP
      | VARIABLE
      | LITERAL

    VARIABLE ::=
        BUILTIN_VARIABLES
      | COMMAND_VARIABLES
      | ENVIRONMENT_VARIABLES

    BUILTIN_VARIABLES ::=
        '$prj'
      | '$env'
      | '$ver'
      | '$cmd'
      | '$user'

    COMMAND_VARIABLES ::=
        '$' DOWNCASED_IDENTIFIER

    ENVIRONMENT_VARIABLES ::=
        '$' UPCASED_IDENTIFIER

    PREFIX_OP ::=
        '!'

    INFIX_OP ::=
        '&&'
      | '||'
      | '<='
      | '<'
      | '=='
      | '='
      | '!='
      | '>='
      | '>'
      | '~>'

    SUFFIX_OP ::=
        '?'

    # Files
    PATH ::= <path> '/' <*>
    FILE ::= <path> '/' <*.sql> | <*.psql> | <*.fox> | <*.prick> | <*.rb>

    # Reference & identifier
    REF ::= .? IDENT ( . IDENT )*
    IDENT ::= /[\w.]+/

    # Inline source
    SOURCE ::=
        <line>
      | '|' <indented lines>

)

opts, args = ShellOpts.process(SPEC, ARGV)

file = opts.file || Compiler::DEFAULT_SOURCE_FILE
USE_EXCEPTION = opts.exception?
Trace.enable if opts.trace?
ShellOpts.exception = USE_EXCEPTION
exclude = opts.exclude
resource_file = opts.resource_file

# Extract command
cmd = args.extract(1)
%w(build make run).include?(cmd) or ShellOpts::error "Illegal command: #{cmd}"
# TODO: Use cmd

# Extract targets
targets = []
while arg = args.first
  break if arg !~ /^#{Prick::Lang::Token::TARGET_PATTERN}$/
  targets << args.shift
end
targets = [Prick::Lang::Compiler::DEFAULT_TARGET] if targets.empty?

# FIXME
BUILTIN_VARIABLES = { cmd: "build", env: "prod", ver: Semver.new("1.2.3"), user: "me" }

# Extract variable assignments
variables = BUILTIN_VARIABLES.dup
if arg = args.shift
  case arg
    when /^(\w+)=(\S*)$/
      variables[$1.to_sym] = $2
    else
      ShellOpts::error "Illegal argument '#{arg}'"
  end
end

# Handle dump option. 'units' is the default
if opts.dump?
  kinds = opts.dump || "units"
  (unknowns = kinds - Prick::Lang::DUMP_KINDS) or ShellOpts::error "Illegal value for --dump '#{unknowns.first}'"
# Prick::Lang::DUMP_KINDS.include?(kind) or ShellOpts::error "Illegal value for --dump '#{kind}'"
  Prick::Lang.dump(kinds, file, targets, exclude, variables)
  exit
end

# Compile
compiler = Prick::Lang::Compiler.new(
    file, targets, completed_resources_file: resource_file, exclude: exclude, variables: variables)
begin
  compiler.compile
rescue => ex
  raise Prick::Lang::ErrorFunctions.pretty_backtrace!(ex)
end

__END__
    EXPR ::=
        CONSTANT-EXPR
      | RESOURCE-EXPR
      | ! EXPR
      | EXPR && EXPR
      | EXPR || EXPR
      | '(' EXPR ')'

    # 'env', 'cmd', and 'user' or's their arguments together, 'version' and's
    # them
    CONSTANT-EXPR ::=
        env IDENT+
      | cmd IDENT+
      | user IDENT+
      | version VER_EXPR+
      | var IDENT IDENT+

    RESOURCE-EXPR ::=
        schema IDENT
      | object REF
      | resource REF

    IDENT-EXPR ::=
      IDENT IDENT-OP
      IDENT ==|!= IDENT-OR-STRING

    VAR-EXPR ::= env | cmd | user | version | schema | object | resource

    VER-EXPR ::= VER-OP VER

    VAL-EXPR ::=
        IDENT
      | VER
      | VER-EXPR


