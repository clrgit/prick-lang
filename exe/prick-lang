#!/usr/bin/env ruby

require 'shellopts'

require_relative '../lib/prick.rb'
require_relative '../doc/doc.rb'

SPEC = %(
  @ Prick compiler

  #-- [OPTIONS] COMMAND

  Compile a prick project

  -s,superuser=USERNAME
    The superuser to connect as when doing RDBMS operations. Default is the
    user executing the command

  -d,database=DATABASE
    Override current database. This makes prick ignore its state file

  --timestamp=TIMESTAMP
    Override timestamp from the database state

  +x,exclude=SCHEMA,
    Comma-separated list of excluded schemas

  -C,directory=DIR
    Switch to directory before doing anything else. Used in debug

  -l,log
    Log commands to stderr

  --reflections-file=EFILE
    Reflections file. Default is '#{Prick::SCHEMA_DIRNAME}/#{Prick::REFLECTIONS_FILENAME}'

  --dump=tokens|ast|idr|links|deps|marks|units|state,
    Dump debug. Default is 'ast'

  -D,dryrun
    Do not do any changes

  -X,exception
    Throw exceptions instead of using ShellOpts error message. Useful to
    pinpoint the source of an error when developing

  -T,trace
    Enable tracer. Used for debugging

  init! --name=NAME --title=TITLE -- [DIR]
    Create a prick project. DIR is created if needed, using '.' as default

  term!
    Delete a prick project, its files, and all associated users

  setup! -f,force -- [DATABASE] ENVIRONMENT
    Setup a new database owned by username and with the given environment. The
    default database name is the environment, eg. 'prick setup dev' for a
    database named 'dev' using the 'dev' environment

  teardown! --keep-owner -- DATABASE
    Teardown a database and associated users

  info!
    Print some info

  list! -l,long -- [database|environments|users]
    List databases

  set -- [database|username|environment] VALUE
    Change database environment

  cd! -- DATABASE
    Change Database

  pwd!
    Print Working Database. Note that it may be empty

  build! -- [VAR=VAL...] [TARGET...]
    Builds the given targets, default is 'term'

  make! -- [VAR=VAL...] [TARGET...]
    Like build but only update changed resources

  migrate! -- MERGE-BACKUP
    Migrate database and merge seed data

  merge! -- MERGE-BACKUP
    Merge production data into the database

  update!
    Merge sagsys online data into the database. FIXME Mikras specific

  run! PROCEDURE

  save! -- meta|seed|user|data [TARGET...]
  load! -- BACKUP
  move! -- SCHEMA SCHEMA

  backup!
    Create a full backup

  restore! -- BACKUP
    Restore a full bvackup
)

opts, args = ShellOpts.process(SPEC, ARGV, verbose: true, version: true)
COMMANDS = opts.__grammar__.commands.map(&:name)

# Switch directory if requested. TODO: Delay until after --*-file has been resolved
Dir.chdir opts.directory if opts.directory?

# Enable trace if requested
Trace.enable if opts.trace?

# Replace ShellOpts errors with exceptions if requested
ShellOpts.exception = opts.exception?

# Extract command
cmd = opts.subcommand!.__name__
COMMANDS.include?(cmd) or ShellOpts::error "Illegal command #{cmd}"

# Create command object
command = Prick::Command.create(cmd, opts, args)

# Execute
command.run

